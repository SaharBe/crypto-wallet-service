# Rendered to /etc/nginx/conf.d/default.conf at container start by the stock
# nginx image entrypoint (/docker-entrypoint.d/20-envsubst-on-templates.sh).
#
# Only ${...} tokens whose name is present in the container environment are
# substituted: WALLET_SERVICE_HOST / ORDER_SERVICE_HOST / BACKEND_PORT
# (defaulted in the Dockerfile and the Deployment) and NGINX_LOCAL_RESOLVERS
# (set by the image's own /docker-entrypoint.d/15-local-resolvers.envsh from
# the pod's /etc/resolv.conf — i.e. the kube-dns ClusterIP). Native nginx
# variables ($uri, $host, $wallet_host, ...) are left untouched.

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Resolve backend Service names at request time via cluster DNS so the pod
    # does not CrashLoop if a backend is not yet registered when nginx starts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # ── Static SPA ───────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }

    # ── Frontend liveness / readiness ────────────────────────────
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","service":"frontend"}';
    }

    # ── wallet-service proxy — same-origin, so no CORS ───────────
    location /api/wallet/ {
        set $wallet_host "${WALLET_SERVICE_HOST}";
        rewrite ^/api/wallet/(.*)$ /$1 break;
        proxy_pass http://$wallet_host:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    15s;
    }

    # ── order-service proxy — same-origin, so no CORS ────────────
    location /api/order/ {
        set $order_host "${ORDER_SERVICE_HOST}";
        rewrite ^/api/order/(.*)$ /$1 break;
        proxy_pass http://$order_host:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    15s;
    }
}
