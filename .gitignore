# Node dependencies
node_modules/
npm-debug.log

# Docker local data
.pgdata/

# ── Secrets: never committed. Only the *.example templates are tracked. ──
# Bootstrap-time secrets (DB creds, GitHub PAT, Vault token)
secrets.env
# Bootstrap repo credential Secret (seeded imperatively by bootstrap.sh)
k8s/bootstrap-secrets/repo-secret.yaml
# Local docker compose settings (generated from .env.example by `make local-up`)
.env
.env.*
!.env.example
# Keys, certificates and kubeconfigs
*.pem
*.key
*.p12
*.pfx
kubeconfig*
*.kubeconfig

# ── Terraform: repo-wide, so a `terraform init/apply` run from any directory
# can't leak state. terraform/.gitignore repeats these for that subtree. ──
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
backend.hcl

# Claude Code: per-user local settings (personal permission rules); the
# shared .claude/settings.json, if added, is meant to be committed.
.claude/settings.local.json
