        "textMode": "auto"
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Consumer group lag by topic",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "description": "kafka_consumergroup_lag from kafka-exporter (k8s/apps/kafka/), summed over partitions.",
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Produce vs consume rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[$__rate_interval]))",
          "legendFormat": "produced {{topic}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup, topic) (rate(kafka_consumergroup_current_offset_sum{consumergroup=~\"$consumergroup\"}[$__rate_interval]))",
          "legendFormat": "consumed {{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "description": "msgs/s. Lag grows whenever produced > consumed.",
      "id": 18
    },
    {
      "type": "row",
      "title": "Resource utilization",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "panels": [],
      "id": 19
    },
