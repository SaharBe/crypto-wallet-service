# No longer applied directly — kept only as a reference for the shape of
# the bootstrap-time seed secret. See bootstrap.sh: it's generated with
# `kubectl create secret generic ... --from-literal` from secrets.env,
# never written to disk as a manifest. Once ArgoCD + ESO are up,
# k8s/apps/argocd-repo-secret.yaml's ExternalSecret takes ownership of the
# same object (private-repo-creds) and keeps it in sync from Vault.
apiVersion: v1
kind: Secret
metadata:
  name: private-repo-creds
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/<your-org>/<your-repo>.git
  username: <github-username>
  password: <github-personal-access-token>
