# Local docker compose settings. `make local-up` copies this to .env (gitignored)
# and fills POSTGRES_PASSWORD with a random value. Never commit .env.

# Postgres: local-only throwaway credentials (production's come from Vault via ESO)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=
POSTGRES_DB=mydb

# Host ports (all bound to 127.0.0.1). 8080 is avoided: `make ingress-forward` uses it.
FRONTEND_HOST_PORT=8088
WALLET_HOST_PORT=3001
ORDER_HOST_PORT=3002
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=29092
