# Copy to secrets.env (gitignored) and fill in real values.
# `source`-d by bootstrap.sh; also exported as TF_VAR_* for terraform/vault-config.

# Dev-mode Vault root token (see k8s/apps/vault.yaml — server.dev.enabled=true)
VAULT_TOKEN=root

# Initial crypto-db credentials, written into Vault by terraform/vault-config
DB_USERNAME=myuser
DB_PASSWORD=mypassword

# GitHub PAT ArgoCD uses to read the private repo. Used twice: once to seed
# the bootstrap-time Secret imperatively, once written into Vault so ESO can
# take over managing it afterwards.
GITHUB_USERNAME=SaharBe
GITHUB_PAT=changeme
